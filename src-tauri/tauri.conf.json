{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vektor",
  "version": "1.1.1",
  "identifier": "com.linkconsulting.vektor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vektor",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Link Consulting",
    "shortDescription": "Otimizador de PC e CS2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": [
      "resources/npi/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1M0I2NzVFMjBGNDdGQTgKUldTb2YvUWdYbWM3cGZZYlJXMHppTUlzdkNRY0IzV1Fkb3Y2VWg3M0Z3cW4zakdvVkFlRUs2bTEK",
      "endpoints": [
        "https://github.com/PedroGrilo/vektor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
